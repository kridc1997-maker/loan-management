# Server
PORT=3001
NODE_ENV=production

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_management
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT — ต้องเปลี่ยนเป็น random string ยาวอย่างน้อย 64 ตัวอักษร
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHARS_STRING
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHARS_STRING
JWT_REFRESH_EXPIRES_IN=7d

# CORS — ใส่ domain จริง หรือลบออกได้เพราะ prod serve frontend จาก Express เอง
FRONTEND_URL=http://localhost:3001
